# =============================================================================
# Spring LMS API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp example.env .env
#
# Required variables will cause the app to fail at startup if missing.
# Optional variables have sensible defaults for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# PORT=8080

# -----------------------------------------------------------------------------
# Database (MySQL 8.0+)
# Required — the app won't start without a reachable database.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lmsdb
DB_USER=root
DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
# JWT Secrets
# Required — the app won't start without these.
# Must be at least 32 characters each.
# Rotate after any exposure; previously issued tokens become invalid.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=changeme-at-least-32-characters-long
JWT_REFRESH_SECRET=changeme-different-at-least-32-characters

# Optional — token lifetimes (Spring Duration format).
# Defaults: access=30m, refresh=1d
# JWT_ACCESS_EXPIRATION=30m
# JWT_REFRESH_EXPIRATION=1d

# -----------------------------------------------------------------------------
# Redis / Valkey
# Optional — only needed for refresh token storage and rate limiting.
# If not running Redis, the app boots but refresh tokens and rate limiting
# will fail at runtime.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# RabbitMQ
# Optional — only needed for the progress report export feature.
# If not running RabbitMQ, the app boots but export endpoints return 503.
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# -----------------------------------------------------------------------------
# CORS
# Optional — allowed origins for cross-origin requests.
# Default: http://localhost:5173 (Vite dev server).
# -----------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:5173
